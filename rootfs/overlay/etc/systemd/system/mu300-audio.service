[Unit]
Description=MU300 Unisoc sound card and audio DSP (sprdphone-sc2730)
# The card needs its drivers, the DMA engine and a hand-written bind; extra-modules has run by then.
After=mu300-extra-modules.service
# On 5.4 the drivers are mu300-audio's (.../audio, https://github.com/dikeckaan/mu300-audio); on mainline they come with the release, and what says call
# audio is wanted there is the AGDSP image the user installed (mu300-audio-dsp install FILE): either one starts it.
ConditionPathIsDirectory=|/lib/modules/%v/audio
ConditionPathExists=|/lib/firmware/agdsp.bin

[Service]
Type=oneshot
RemainAfterExit=yes
# "start" checks the card is registered before it touches the DSP reset registers: doing that with the AGDSP
# power domain down reboots the device. Without a firmware image it stops after the card, which is harmless.
ExecStart=/opt/mu300/bin/mu300-audio-dsp start
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
